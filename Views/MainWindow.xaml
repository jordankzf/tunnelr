<Window x:Class="Tunnelr.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tunnelr.Controls"
        Title="Tunnelr 2 - SSH Tunnel Switchboard"
        Width="420" Height="460"
        MinWidth="414" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgDarkBrush}"
        Icon="/Resources/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Cards -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Background pattern ═══ -->
        <Border Grid.RowSpan="4" Background="{StaticResource CircuitPatternBrush}">
            <Border.CacheMode>
                <BitmapCache/>
            </Border.CacheMode>
        </Border>

        <!-- ═══ Menu Bar ═══ -->
        <Menu Grid.Row="0" Style="{StaticResource CyberMenu}">
            <Menu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CyberMenuCommand}"/>
                <Style TargetType="Separator">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#304457" Margin="7,3"/>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Style="{StaticResource CyberMenuItem}">
                <MenuItem Header="Edit server profile…" Click="Settings_Click"/>
                <MenuItem Header="New server profile…" Click="NewProfile_Click"/>
                <Separator/>
                <MenuItem Header="Import configuration…" Click="Import_Click"/>
                <MenuItem Header="Restore previous save…" Click="Restore_Click"/>
                <MenuItem Header="Open settings folder" Click="Folder_Click"/>
                <Separator/><MenuItem Header="Exit Tunnelr" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="profiles" Header="_Profiles" Style="{StaticResource CyberMenuItem}"/>
            <MenuItem x:Name="groups" Header="_Groups" Style="{StaticResource CyberMenuItem}"/>
            <MenuItem Header="_Help" Style="{StaticResource CyberMenuItem}"><MenuItem Header="Using Tunnelr" Click="Help_Click"/></MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="1" Padding="10,8" Background="#0c101e">
            <Border.BorderBrush>
                <SolidColorBrush Color="#1a2040"/>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Style="{StaticResource NeonButton}"
                        Click="Add_Click" Margin="0,0,8,0"/>
                <Button Content="Edit" Style="{StaticResource NeonButton}"
                        Click="PickEdit_Click" Margin="0,0,8,0"/>
                <Button Content="Delete" Style="{StaticResource NeonButton}"
                        Click="PickDelete_Click" Margin="0,0,8,0"/>
                <Button x:Name="bulk" Content="All On" Style="{StaticResource NeonButton}"
                        Click="Bulk_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ Tunnel Cards Grid ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <Grid Margin="3,10">
                <ItemsControl x:Name="cards" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <WrapPanel ItemWidth="185" ItemHeight="145"/>
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <controls:TunnelCard Click="Toggle_Click" ContextMenuOpening="CardMenuOpening">
                            <controls:TunnelCard.ContextMenu><ContextMenu/></controls:TunnelCard.ContextMenu>
                        </controls:TunnelCard>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="empty" Text="Add a tunnel to get started." Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center"/>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgStatusBarBrush}"
                Padding="12,6" BorderThickness="0,1,0,0">
            <Border.BorderBrush>
                <SolidColorBrush Color="#1a2040"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus"
                               Text="0 of 0 tunnels active"
                               Foreground="{StaticResource NeonCyanBrush}"
                               FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="txtServer"
                           Grid.Column="1"
                           TextTrimming="CharacterEllipsis" MaxWidth="225" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="#8394a8"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
